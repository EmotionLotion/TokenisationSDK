{
  "name": "Event Ticket Asset Policy",
  "version": 1,
  "assetType": "event_ticket",
  "description": "Compliance rules for tokenized event tickets. Supports concerts, sports, conferences.",
  "rules": [
    {
      "id": "event_not_started",
      "type": "require",
      "field": "asset.eventStartTime",
      "op": "gt",
      "value": "time.now",
      "message": "Tickets cannot be transferred after event has started",
      "code": "EVENT_STARTED"
    },
    {
      "id": "transfer_cutoff",
      "type": "require",
      "field": "asset.transferCutoffTime",
      "op": "gt",
      "value": "time.now",
      "message": "Ticket transfers are locked 24 hours before event",
      "code": "TRANSFER_CUTOFF"
    },
    {
      "id": "single_holder",
      "type": "limit",
      "field": "transfer.resultingBalance",
      "op": "lte",
      "value": "1",
      "message": "Each wallet can only hold one ticket of this type",
      "code": "SINGLE_HOLDER_ONLY",
      "skipIf": "asset.allowMultiple == true"
    },
    {
      "id": "max_resale_price",
      "type": "limit",
      "field": "transfer.price",
      "op": "lte",
      "value": "asset.maxResalePrice",
      "message": "Resale price exceeds maximum allowed markup",
      "code": "PRICE_CAP_EXCEEDED",
      "skipIf": "transfer.price == null"
    },
    {
      "id": "not_scalper",
      "type": "block",
      "field": "investor.tags",
      "op": "contains",
      "value": "scalper",
      "message": "Account flagged for scalping activity",
      "code": "SCALPER_BLOCKED"
    },
    {
      "id": "ticket_not_used",
      "type": "require",
      "field": "token.status",
      "op": "neq",
      "value": "redeemed",
      "message": "Ticket has already been used/redeemed",
      "code": "TICKET_USED"
    },
    {
      "id": "ticket_not_cancelled",
      "type": "require",
      "field": "token.status",
      "op": "neq",
      "value": "cancelled",
      "message": "Ticket has been cancelled",
      "code": "TICKET_CANCELLED"
    }
  ],
  "actions": {
    "onDeny": ["log_decision"],
    "onAllow": ["log_decision", "notify_venue"]
  },
  "lifecycle": {
    "onIssue": ["assign_seat", "generate_qr"],
    "onTransfer": ["update_holder", "regenerate_qr", "notify_venue"],
    "onRedeem": ["validate_qr", "mark_used", "burn_token"]
  },
  "consumerProtection": {
    "maxMarkupPercent": 150,
    "refundWindowHours": 48,
    "transferWindowHours": 24
  },
  "metadata": {
    "author": "AHOY Compliance",
    "lastUpdated": "2024-01-01",
    "suitableFor": ["concert", "sports", "conference", "theater"],
    "tokenStandard": "ERC-721"
  }
}
