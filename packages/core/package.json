{
  "name": "@tokenisation/core",
  "version": "1.0.0",
  "description": "Asset-class-agnostic foundation: lifecycle engine, compliance engine, state machine, models, utils, errors, plugins, orchestration, packs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./storage/postgres": {
      "types": "./dist/storage/postgres/index.d.ts",
      "import": "./dist/storage/postgres/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "ethers": "^6.9.0",
    "siwe": "^2.1.4",
    "uuid": "^9.0.0",
    "viem": "^2.44.4",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@metamask/onboarding": "^1.0.1",
    "@walletconnect/modal": "^2.6.0",
    "@walletconnect/universal-provider": "^2.11.0",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.17.2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@walletconnect/universal-provider": {
      "optional": true
    },
    "@walletconnect/modal": {
      "optional": true
    },
    "@metamask/onboarding": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
