{
    "name": "@tokenisation/conformance-suite",
    "version": "1.0.0",
    "description": "Institutional-grade conformance testing for the Tokenisation SDK",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:flow-a": "vitest run src/flows/A_AssetToToken.test.ts",
        "test:flow-b": "vitest run src/flows/B_Onboarding.test.ts",
        "test:flow-c": "vitest run src/flows/C_Compliance.test.ts",
        "test:all": "vitest run src/flows"
    },
    "dependencies": {
        "@tokenisation/sdk": "file:../../sdk",
        "chalk": "^5.3.0",
        "dotenv": "^16.3.1",
        "ethers": "^6.9.0",
        "react": "^18.3.1",
        "react-dom": "^19.2.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "typescript": "^5.3.0",
        "vitest": "^1.0.0"
    }
}
