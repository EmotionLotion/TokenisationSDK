# =============================================================================
# AHOY Sandbox Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before deploying.
# =============================================================================

# PostgreSQL
POSTGRES_USER=ahoy_sandbox
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# JWT
JWT_SECRET=CHANGE_ME_STRONG_SECRET_HERE

# Sandbox API Key (pre-provisioned for partner testing)
SANDBOX_API_KEY=ak_sandbox_demo_key_12345

# Domain (used by Caddy for TLS certificates)
SANDBOX_DOMAIN=sandbox.api.ahoy.fund
