{
    "name": "tokenisation-platform",
    "private": true,
    "packageManager": "pnpm@9.15.0",
    "workspaces": [
        "sdk",
        "ui",
        "ui-kit",
        "sdk-react",
        "sdk-react-native",
        "server",
        "packages/*",
        "_infrastructure/apps/*",
        "_infrastructure/website"
    ],
    "scripts": {
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "quickstart": "cd server && cp -n .env.example .env 2>/dev/null; cd .. && pnpm install && pnpm -r run build && cd server && pnpm db:seed && pnpm dev",
        "quickstart:seed-only": "cd server && pnpm db:seed",
        "playground": "pnpm --filter @tokenisation/sdk-playground dev",
        "test:conformance": "pnpm run test --filter @tokenisation/conformance-suite",
        "test:e2e": "cd _infrastructure && playwright test",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.0",
        "@playwright/test": "^1.42.0"
    }
}
