{
    "name": "tokenisation-platform",
    "private": true,
    "packageManager": "pnpm@9.15.0",
    "workspaces": [
        "sdk",
        "ui",
        "ui-kit",
        "sdk-react",
        "sdk-react-native",
        "server",
        "packages/*",
        "apps/*",
        "website"
    ],
    "scripts": {
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "playground": "pnpm --filter @tokenisation/sdk-playground dev",
        "test:conformance": "pnpm run test --filter @tokenisation/conformance-suite",
        "test:e2e": "playwright test",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.0",
        "@playwright/test": "^1.42.0"
    }
}
