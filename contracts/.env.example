# AHOY Tokenisation SDK - Contract Deployment Environment
# Copy this to .env and fill in your values

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Your deployer wallet private key (with 0x prefix)
# NEVER commit your actual private key!
DEPLOYER_PRIVATE_KEY=0x...

# RPC URLs
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# =============================================================================
# BLOCK EXPLORER API KEYS (for contract verification)
# =============================================================================

# Get at: https://basescan.org/myapikey
BASESCAN_API_KEY=

# Get at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# =============================================================================
# CHAINLINK CONFIGURATION
# =============================================================================

# Chainlink Functions Subscription ID
# Create at: https://functions.chain.link
FUNCTIONS_SUBSCRIPTION_ID=

# =============================================================================
# DEPLOYMENT COMMANDS
# =============================================================================

# Deploy core contracts (IdentityRegistry, TokenFactory, ComplianceToken):
# forge script script/Deploy.s.sol --rpc-url $SEPOLIA_RPC_URL --broadcast --verify

# Deploy Chainlink integration contracts:
# forge script script/DeployChainlink.s.sol --rpc-url $SEPOLIA_RPC_URL --broadcast --verify

# Local testing with Anvil:
# anvil
# forge script script/Deploy.s.sol --rpc-url http://localhost:8545 --broadcast
