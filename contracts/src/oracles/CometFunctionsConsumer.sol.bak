// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {FunctionsClient} from "@chainlink/contracts/src/v0.8/functions/dev/v1_0_0/FunctionsClient.sol";
import {FunctionsRequest} from "@chainlink/contracts/src/v0.8/functions/dev/v1_0_0/libraries/FunctionsRequest.sol";
import {ConfirmedOwner} from "@chainlink/contracts/src/v0.8/shared/access/ConfirmedOwner.sol";

/**
 * @title CometFunctionsConsumer
 * @notice Chainlink Functions consumer for COMET driver scoring and carbon calculations
 * @dev Replaces hardcoded values with oracle-verified computations
 */
contract CometFunctionsConsumer is FunctionsClient, ConfirmedOwner {
    using FunctionsRequest for FunctionsRequest.Request;

    // Request types
    enum RequestType {
        SAFETY_SCORE,
        CARBON_OFFSET,
        LOYALTY_MULTIPLIER
    }

    // Safety score data
    struct SafetyScore {
        uint256 score;          // Score with 2 decimals (e.g., 9500 = 95.00)
        uint256 updatedAt;
        bytes32 requestId;
    }

    // Carbon offset factor
    struct CarbonFactor {
        uint256 factor;         // Factor with 6 decimals
        bytes32 region;
        uint256 updatedAt;
    }

    // Storage
    mapping(bytes32 => SafetyScore) public safetyScores;           // driverId => score
    mapping(bytes32 => mapping(uint8 => CarbonFactor)) public carbonFactors; // region => utilityType => factor
    mapping(bytes32 => uint256) public loyaltyMultipliers;         // tier+action hash => multiplier (4 decimals)

    // Request tracking
    mapping(bytes32 => RequestType) public pendingRequestTypes;
    mapping(bytes32 => bytes32) public pendingRequestSubjects;     // requestId => driverId/region

    // Configuration
    bytes32 public donId;
    uint64 public subscriptionId;
    uint32 public gasLimit = 300000;

    // JavaScript sources (stored on-chain for transparency)
    string public safetyScoreSource;
    string public carbonOffsetSource;
    string public loyaltyMultiplierSource;

    // Events
    event SafetyScoreUpdated(
        bytes32 indexed driverId,
        uint256 score,
        bytes32 requestId,
        uint256 timestamp
    );

    event CarbonFactorUpdated(
        bytes32 indexed region,
        uint8 indexed utilityType,
        uint256 factor,
        uint256 timestamp
    );

    event LoyaltyMultiplierUpdated(
        bytes32 indexed tierActionHash,
        uint256 multiplier,
        uint256 timestamp
    );

    event RequestSent(bytes32 indexed requestId, RequestType requestType);
    event RequestFulfilled(bytes32 indexed requestId, bytes response, bytes err);

    // Errors
    error UnexpectedRequestID(bytes32 requestId);
    error RequestFailed(bytes err);
    error InvalidSource();

    /**
     * @notice Constructor
     * @param router Chainlink Functions router address
     * @param _donId DON ID for the network
     * @param _subscriptionId Chainlink Functions subscription ID
     */
    constructor(
        address router,
        bytes32 _donId,
        uint64 _subscriptionId
    ) FunctionsClient(router) ConfirmedOwner(msg.sender) {
        donId = _donId;
        subscriptionId = _subscriptionId;

        // Set default JavaScript sources
        _setDefaultSources();
    }

    /**
     * @notice Request safety score calculation for a driver
     * @param driverId Unique identifier for the driver
     * @param eventsJson JSON-encoded array of telematics events
     */
    function requestSafetyScore(
        bytes32 driverId,
        string calldata eventsJson
    ) external onlyOwner returns (bytes32 requestId) {
        if (bytes(safetyScoreSource).length == 0) revert InvalidSource();

        FunctionsRequest.Request memory req;
        req.initializeRequestForInlineJavaScript(safetyScoreSource);

        string[] memory args = new string[](1);
        args[0] = eventsJson;
        req.setArgs(args);

        requestId = _sendRequest(
            req.encodeCBOR(),
            subscriptionId,
            gasLimit,
            donId
        );

        pendingRequestTypes[requestId] = RequestType.SAFETY_SCORE;
        pendingRequestSubjects[requestId] = driverId;

        emit RequestSent(requestId, RequestType.SAFETY_SCORE);
    }

    /**
     * @notice Request carbon offset factor calculation
     * @param region Region code (e.g., "UAE", "EU")
     * @param utilityType Utility type (0=WATER, 1=ELECTRICITY, 2=GAS, 3=COLD_CHAIN)
     * @param quantity Amount of utility consumed
     */
    function requestCarbonOffset(
        bytes32 region,
        uint8 utilityType,
        uint256 quantity
    ) external onlyOwner returns (bytes32 requestId) {
        if (bytes(carbonOffsetSource).length == 0) revert InvalidSource();

        FunctionsRequest.Request memory req;
        req.initializeRequestForInlineJavaScript(carbonOffsetSource);

        string[] memory args = new string[](3);
        args[0] = _utilityTypeToString(utilityType);
        args[1] = _uint256ToString(quantity);
        args[2] = string(abi.encodePacked(region));
        req.setArgs(args);

        requestId = _sendRequest(
            req.encodeCBOR(),
            subscriptionId,
            gasLimit,
            donId
        );

        pendingRequestTypes[requestId] = RequestType.CARBON_OFFSET;
        pendingRequestSubjects[requestId] = keccak256(abi.encode(region, utilityType));

        emit RequestSent(requestId, RequestType.CARBON_OFFSET);
    }

    /**
     * @notice Request loyalty multiplier for a tier and action
     * @param tier Driver tier (e.g., "GOLD", "PLATINUM")
     * @param actionType Action type (e.g., "PERFECT_DELIVERY")
     */
    function requestLoyaltyMultiplier(
        string calldata tier,
        string calldata actionType
    ) external onlyOwner returns (bytes32 requestId) {
        if (bytes(loyaltyMultiplierSource).length == 0) revert InvalidSource();

        FunctionsRequest.Request memory req;
        req.initializeRequestForInlineJavaScript(loyaltyMultiplierSource);

        string[] memory args = new string[](2);
        args[0] = tier;
        args[1] = actionType;
        req.setArgs(args);

        requestId = _sendRequest(
            req.encodeCBOR(),
            subscriptionId,
            gasLimit,
            donId
        );

        pendingRequestTypes[requestId] = RequestType.LOYALTY_MULTIPLIER;
        pendingRequestSubjects[requestId] = keccak256(abi.encode(tier, actionType));

        emit RequestSent(requestId, RequestType.LOYALTY_MULTIPLIER);
    }

    /**
     * @notice Callback for Chainlink Functions
     */
    function fulfillRequest(
        bytes32 requestId,
        bytes memory response,
        bytes memory err
    ) internal override {
        emit RequestFulfilled(requestId, response, err);

        if (err.length > 0) {
            // Don't revert, just log the error
            return;
        }

        RequestType reqType = pendingRequestTypes[requestId];
        bytes32 subject = pendingRequestSubjects[requestId];

        if (reqType == RequestType.SAFETY_SCORE) {
            _processSafetyScoreResponse(subject, requestId, response);
        } else if (reqType == RequestType.CARBON_OFFSET) {
            _processCarbonOffsetResponse(subject, response);
        } else if (reqType == RequestType.LOYALTY_MULTIPLIER) {
            _processLoyaltyMultiplierResponse(subject, response);
        }

        // Cleanup
        delete pendingRequestTypes[requestId];
        delete pendingRequestSubjects[requestId];
    }

    /**
     * @notice Get safety score for a driver
     */
    function getSafetyScore(bytes32 driverId) external view returns (
        uint256 score,
        uint256 updatedAt,
        bool isStale
    ) {
        SafetyScore memory ss = safetyScores[driverId];
        score = ss.score;
        updatedAt = ss.updatedAt;
        isStale = (block.timestamp - ss.updatedAt) > 1 days;
    }

    /**
     * @notice Get carbon factor for a region and utility type
     */
    function getCarbonFactor(
        bytes32 region,
        uint8 utilityType
    ) external view returns (uint256 factor, uint256 updatedAt) {
        CarbonFactor memory cf = carbonFactors[region][utilityType];
        return (cf.factor, cf.updatedAt);
    }

    /**
     * @notice Calculate carbon offset using stored factor
     */
    function calculateCarbonOffset(
        bytes32 region,
        uint8 utilityType,
        uint256 quantity // 18 decimals
    ) external view returns (uint256 offsetKg) {
        uint256 factor = carbonFactors[region][utilityType].factor;

        // Default factors if not set (6 decimals)
        if (factor == 0) {
            if (utilityType == 0) factor = 1200;      // WATER: 0.0012
            else if (utilityType == 1) factor = 450000; // ELECTRICITY: 0.45
            else if (utilityType == 2) factor = 2000000; // GAS: 2.0
            else factor = 120000;                      // COLD_CHAIN: 0.12
        }

        // quantity (18 decimals) * factor (6 decimals) / 1e18 = result (6 decimals)
        offsetKg = (quantity * factor) / 1e18;
    }

    // Admin functions

    /**
     * @notice Update JavaScript sources
     */
    function updateSources(
        string calldata _safetyScoreSource,
        string calldata _carbonOffsetSource,
        string calldata _loyaltyMultiplierSource
    ) external onlyOwner {
        if (bytes(_safetyScoreSource).length > 0) {
            safetyScoreSource = _safetyScoreSource;
        }
        if (bytes(_carbonOffsetSource).length > 0) {
            carbonOffsetSource = _carbonOffsetSource;
        }
        if (bytes(_loyaltyMultiplierSource).length > 0) {
            loyaltyMultiplierSource = _loyaltyMultiplierSource;
        }
    }

    /**
     * @notice Update configuration
     */
    function updateConfig(
        bytes32 _donId,
        uint64 _subscriptionId,
        uint32 _gasLimit
    ) external onlyOwner {
        donId = _donId;
        subscriptionId = _subscriptionId;
        gasLimit = _gasLimit;
    }

    // Internal functions

    function _processSafetyScoreResponse(
        bytes32 driverId,
        bytes32 requestId,
        bytes memory response
    ) internal {
        // Response is JSON: {"score": 95.5, "breakdown": {...}}
        // For simplicity, we decode just the score (would use JSON parsing in production)
        uint256 score = abi.decode(response, (uint256));

        safetyScores[driverId] = SafetyScore({
            score: score,
            updatedAt: block.timestamp,
            requestId: requestId
        });

        emit SafetyScoreUpdated(driverId, score, requestId, block.timestamp);
    }

    function _processCarbonOffsetResponse(
        bytes32 subjectHash,
        bytes memory response
    ) internal {
        // Decode region and utilityType from subject hash stored separately
        // For now, decode factor directly
        uint256 factor = abi.decode(response, (uint256));

        // This would need the region and utilityType passed differently in production
        // For demo purposes, emit event
        emit CarbonFactorUpdated(subjectHash, 0, factor, block.timestamp);
    }

    function _processLoyaltyMultiplierResponse(
        bytes32 tierActionHash,
        bytes memory response
    ) internal {
        uint256 multiplier = abi.decode(response, (uint256));
        loyaltyMultipliers[tierActionHash] = multiplier;

        emit LoyaltyMultiplierUpdated(tierActionHash, multiplier, block.timestamp);
    }

    function _setDefaultSources() internal {
        // Minimal default sources - would be set properly in production
        safetyScoreSource = "const events = JSON.parse(args[0]); let score = 10000; for (const e of events) { score -= e.count * 100; } return Functions.encodeUint256(Math.max(0, score));";

        carbonOffsetSource = "const [type, qty, region] = args; const factors = {WATER: 1200, ELECTRICITY: 450000, GAS: 2000000}; return Functions.encodeUint256(factors[type] || 500000);";

        loyaltyMultiplierSource = "const [tier, action] = args; const bonuses = {BRONZE: 10000, SILVER: 10500, GOLD: 11000, PLATINUM: 12000}; return Functions.encodeUint256(bonuses[tier] || 10000);";
    }

    function _utilityTypeToString(uint8 utilityType) internal pure returns (string memory) {
        if (utilityType == 0) return "WATER";
        if (utilityType == 1) return "ELECTRICITY";
        if (utilityType == 2) return "GAS";
        return "COLD_CHAIN";
    }

    function _uint256ToString(uint256 value) internal pure returns (string memory) {
        if (value == 0) return "0";

        uint256 temp = value;
        uint256 digits;
        while (temp != 0) {
            digits++;
            temp /= 10;
        }

        bytes memory buffer = new bytes(digits);
        while (value != 0) {
            digits -= 1;
            buffer[digits] = bytes1(uint8(48 + uint256(value % 10)));
            value /= 10;
        }

        return string(buffer);
    }
}
