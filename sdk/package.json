{
  "name": "@tokenisation/sdk",
  "version": "1.0.0",
  "description": "Modular tokenisation infrastructure that abstracts compliance, issuance, and asset lifecycle management for real-world assets",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./packs": {
      "types": "./dist/packs/index.d.ts",
      "import": "./dist/packs/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./connectors": {
      "types": "./dist/connectors/index.d.ts",
      "import": "./dist/connectors/index.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsx scripts/build-cjs.ts",
    "build:cjs": "tsx scripts/build-cjs.ts",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config tests/integration/vitest.integration.config.ts",
    "test:integration:stripe": "vitest run --config tests/integration/vitest.integration.config.ts tests/integration/stripe/",
    "test:integration:circle": "vitest run --config tests/integration/vitest.integration.config.ts tests/integration/circle/",
    "test:integration:chainlink-fork": "vitest run --config tests/integration/vitest.integration.config.ts tests/integration/chainlink-fork.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "cli": "node dist/cli/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "size": "npx size-limit"
  },
  "keywords": [
    "tokenisation",
    "rwa",
    "blockchain",
    "sdk",
    "real-world-assets"
  ],
  "author": "AHOY <engineering@ahoy.fund>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahoy-fund/tokenisation-sdk",
    "directory": "sdk"
  },
  "homepage": "https://docs.ahoy.fund/sdk",
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^1.0.0",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.20.2",
    "size-limit": "^11.0.0",
    "tsx": "^4.7.0",
    "typedoc": "^0.25.0",
    "typedoc-plugin-markdown": "^3.17.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@tokenisation/core": "workspace:*",
    "@tokenisation/compliance": "workspace:*",
    "@tokenisation/chains": "workspace:*",
    "@tokenisation/realestate": "workspace:*",
    "commander": "^11.1.0",
    "ethers": "^6.9.0",
    "siwe": "^2.1.4",
    "uuid": "^9.0.0",
    "viem": "^2.44.4",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@metamask/onboarding": "^1.0.1",
    "@walletconnect/modal": "^2.6.0",
    "@walletconnect/universal-provider": "^2.11.0",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.17.2",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@walletconnect/universal-provider": {
      "optional": true
    },
    "@walletconnect/modal": {
      "optional": true
    },
    "@metamask/onboarding": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "tokenise": "./dist/cli/index.js"
  }
}
