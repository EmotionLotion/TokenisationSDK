              "raw": "{{base_url}}/api/v1/tokens/{{token_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tokens", "{{token_id}}"]
            }
          }
        },
        {
          "name": "Deploy Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/tokens/{{token_id}}/deploy",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tokens", "{{token_id}}", "deploy"]
            }
          }
        }
      ]
    },
    {
      "name": "Investors",
      "item": [
