              "mode": "raw",
              "raw": "{\n  \"address\": \"0x1234567890abcdef1234567890abcdef12345678\",\n  \"chainId\": 137,\n  \"label\": \"Primary Wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/investors/{{investor_id}}/wallets",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "investors", "{{investor_id}}", "wallets"]
            }
          }
        }
      ]
    },
