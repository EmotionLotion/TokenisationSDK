          }
        },
        {
          "name": "Create Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Property Token\",\n  \"symbol\": \"PROP\",\n  \"projectId\": \"{{project_id}}\",\n  \"assetId\": \"{{asset_id}}\",\n  \"standard\": \"ERC3643\",\n  \"chainId\": 137,\n  \"decimals\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tokens",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tokens"]
            }
          }
        },
        {
          "name": "Get Token",
          "request": {
            "method": "GET",
            "header": [],
