# AHOY Tokenisation API Server - Environment Configuration

# ====================
# Database Configuration
# ====================
# Mode: 'sqlite' (default, no setup required) or 'postgresql' (production)
DB_MODE=sqlite

# SQLite (default for development - file stored in ./data/ahoy.db)
SQLITE_PATH=./data/ahoy.db

# PostgreSQL (for production - requires Docker or local installation)
DATABASE_URL=postgres://ahoy:ahoy_dev_password@localhost:5432/ahoy_tokenisation

# ====================
# Server
# ====================
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ====================
# Authentication
# ====================
# CRITICAL: In production, JWT_SECRET is REQUIRED and must be at least 32 characters
# Generate a secure secret: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# JWT token validation settings
JWT_ISSUER=tokenisation-api
JWT_AUDIENCE=tokenisation-sdk

# ====================
# Development Auth Bypass
# ====================
# WARNING: AUTH_DEV_MODE enables authentication bypass in development
# This allows using x-dev-party-id or x-dev-org-id headers instead of real tokens
# The server will REFUSE TO START if AUTH_DEV_MODE=true in production!
# Set to 'false' or remove entirely for any non-development environment
AUTH_DEV_MODE=true

# ====================
# Redis (REQUIRED for production - distributed rate limiting)
# ====================
# When REDIS_URL is set, rate limiting is distributed across all server instances.
# Without Redis, rate limiting uses in-memory storage (not recommended for production).
# REDIS_URL=redis://localhost:6379
# For Redis with password: REDIS_URL=redis://:password@localhost:6379
# For Redis Cluster: REDIS_URL=redis://node1:6379,node2:6379,node3:6379

# ====================
# Blockchain RPC URLs
# ====================
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# ====================
# Chainlink (optional for dev)
# ====================
CHAINLINK_CCIP_ROUTER_BASE=0x881e3A65B4d4a04dD529061dd0071cf975F58bCD

# ====================
# Storage Configuration
# ====================
# Default storage provider: 's3', 'ipfs', or 'azure'
DEFAULT_STORAGE_PROVIDER=s3

# S3 / S3-Compatible Storage (AWS, MinIO, DigitalOcean Spaces)
S3_ENABLED=false
S3_REGION=us-east-1
S3_BUCKET=tokenisation-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: Custom endpoint for S3-compatible services (MinIO, DO Spaces)
S3_ENDPOINT=
# Set to true for MinIO or path-style S3 access
S3_FORCE_PATH_STYLE=false

# IPFS via Pinata
IPFS_ENABLED=false
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ====================
# OpenAPI Documentation URLs
# ====================
# API base URL shown in Swagger documentation
API_BASE_URL=http://localhost:3001/api/v1
SANDBOX_API_URL=https://sandbox.api.ahoy.fund/v1
PRODUCTION_API_URL=https://api.ahoy.fund/v1

# ====================
# Email Notifications (SendGrid)
# ====================
SENDGRID_API_KEY=
SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send
EMAIL_FROM_ADDRESS=noreply@ahoy.fund
EMAIL_FROM_NAME=AHOY Tokenisation

# ====================
# KYC Provider Configuration
# ====================
# SumSub (default KYC provider)
SUMSUB_API_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# Onfido
ONFIDO_API_URL=https://api.onfido.com/v3
ONFIDO_API_TOKEN=

# ====================
# Custody Provider Configuration
# ====================
# Fireblocks
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_SECRET=
FIREBLOCKS_BASE_URL=https://api.fireblocks.io

# BitGo
BITGO_ACCESS_TOKEN=
BITGO_BASE_URL=https://app.bitgo.com

# ====================
# OpenTelemetry Observability
# ====================
# Enable OpenTelemetry (set to 'true' to enable distributed tracing & metrics)
OTEL_ENABLED=false
# OTLP exporter endpoint (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Service name for traces
OTEL_SERVICE_NAME=tokenisation-api
# Enable debug logging for OpenTelemetry
OTEL_DEBUG=false
