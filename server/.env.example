# AHOY Tokenisation API Server - Environment Configuration

# ====================
# Database Configuration
# ====================
# Mode: 'sqlite' (default, no setup required) or 'postgresql' (production)
DB_MODE=sqlite

# SQLite (default for development - file stored in ./data/ahoy.db)
SQLITE_PATH=./data/ahoy.db

# PostgreSQL (for production - requires Docker or local installation)
DATABASE_URL=postgres://ahoy:ahoy_dev_password@localhost:5432/ahoy_tokenisation

# ====================
# Server
# ====================
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ====================
# Authentication
# ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Development mode - allows auth bypass with x-dev-party-id header
# WARNING: Never enable in production!
AUTH_DEV_MODE=true

# ====================
# Redis (optional - for session/rate limiting)
# ====================
REDIS_URL=redis://localhost:6379

# ====================
# Blockchain RPC URLs
# ====================
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# ====================
# Chainlink (optional for dev)
# ====================
CHAINLINK_CCIP_ROUTER_BASE=0x881e3A65B4d4a04dD529061dd0071cf975F58bCD

# ====================
# Storage Configuration
# ====================
# Default storage provider: 's3', 'ipfs', or 'azure'
DEFAULT_STORAGE_PROVIDER=s3

# S3 / S3-Compatible Storage (AWS, MinIO, DigitalOcean Spaces)
S3_ENABLED=false
S3_REGION=us-east-1
S3_BUCKET=tokenisation-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: Custom endpoint for S3-compatible services (MinIO, DO Spaces)
S3_ENDPOINT=
# Set to true for MinIO or path-style S3 access
S3_FORCE_PATH_STYLE=false

# IPFS via Pinata
IPFS_ENABLED=false
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
